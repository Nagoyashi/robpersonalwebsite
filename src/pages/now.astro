---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'now');
if (!entry) throw new Error('Missing src/content/now.md');
const { Content } = await render(entry);
---

<Base title="Now — Robert Kiss" description="What Robert Kiss is focused on right now.">
  <section class="section container">
    <div class="prose">
      <a href="/" class="back-link">← back</a>
      <h1>{entry.data.title}</h1>
      {entry.data.updated && <p class="updated">updated {entry.data.updated}</p>}
      <Content />
    </div>
  </section>
</Base>
