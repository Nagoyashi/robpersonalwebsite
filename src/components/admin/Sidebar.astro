---
// Control-center sidebar — expanded (250px) + collapsed (70px), matching the
// handoff prototype. Both states render; AdminShell's CSS shows one and the
// toggle persists the choice. Nav uses real <a> links (works without JS).
import { products } from '../../config/products';

interface Props {
  page: string;
}
const { page } = Astro.props;

const liveCount = products.filter((p) => p.status === 'live').length;
const buildCount = products.filter((p) => p.status === 'building').length;

// 18px outline icons (stroke 1.6), Lucide-style.
const icons: Record<string, string> = {
  overview:
    '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  uptime: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  digest:
    '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/>',
  ideation: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  analytics: '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  marketing: '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  notes: '<path d="M15.5 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5L15.5 3z"/><path d="M15 3v6h6"/>',
};

const nav = [
  { key: 'overview', label: 'overview', href: '/admin' },
  { key: 'digest', label: 'digest', href: '/admin/digest' },
  { key: 'uptime', label: 'uptime', href: '/admin/uptime' },
  { key: 'ideation', label: 'ideation', href: '/admin/ideation' },
  { key: 'analytics', label: 'analytics', href: '/admin/analytics' },
  { key: 'marketing', label: 'marketing', href: '/admin/marketing' },
  { key: 'notes', label: 'notes', href: '/admin/notes' },
];

const svg = (key: string) =>
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${icons[key]}</svg>`;
---

<!-- Expanded (250px) -->
<aside
  class="adm-side-expanded"
  style="width:250px;flex-shrink:0;position:sticky;top:0;height:100vh;border-right:1px solid rgba(255,255,255,.08);background:rgba(6,7,15,.74);backdrop-filter:blur(12px);display:flex;flex-direction:column;padding:24px 16px;overflow:hidden"
>
  <div style="padding:0 8px 4px">
    <div
      style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:17px;color:#f0f3f8;letter-spacing:-.3px;white-space:nowrap"
    >
      rob<span style="color:#6e7681">//</span><span style="color:#00e0ff">ctrl</span>
    </div>
    <div
      style="font-family:'JetBrains Mono',monospace;font-size:10.5px;color:#6e7681;letter-spacing:2px;text-transform:uppercase;margin-top:3px;white-space:nowrap"
    >
      control center
    </div>
  </div>

  <nav style="display:flex;flex-direction:column;gap:3px;margin-top:26px">
    {
      nav.map((n) => (
        <a href={n.href} class:list={['adm-nav', { active: n.key === page }]}>
          <span style="display:flex;flex-shrink:0" set:html={svg(n.key)} />
          <span style="flex:1;white-space:nowrap">{n.label}</span>
        </a>
      ))
    }
  </nav>

  <div style="margin-top:auto;display:flex;flex-direction:column;gap:10px">
    <div style="padding:12px 10px;border-radius:9px;border:1px solid rgba(63,185,80,.2);background:rgba(63,185,80,.06)">
      <div
        style="display:flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:12px;color:#3fb950;white-space:nowrap"
      >
        <span
          style="width:8px;height:8px;border-radius:50%;background:#3fb950;box-shadow:0 0 8px #3fb950;animation:admPulseDot 2s ease-in-out infinite"
        ></span>
        all systems online
      </div>
      <div
        style="font-family:'JetBrains Mono',monospace;font-size:10.5px;color:#6e7681;margin-top:5px;white-space:nowrap"
      >
        {liveCount} live · {buildCount} building
      </div>
    </div>
    <button data-side-toggle class="adm-toggle" title="Collapse sidebar" aria-label="Collapse sidebar">«</button>
    <a href="/admin/auth/signout" class="adm-signout">sign out</a>
  </div>
</aside>

<!-- Collapsed (70px) -->
<aside
  class="adm-side-collapsed"
  style="width:70px;flex-shrink:0;position:sticky;top:0;height:100vh;border-right:1px solid rgba(255,255,255,.08);background:rgba(6,7,15,.74);backdrop-filter:blur(12px);flex-direction:column;padding:24px 10px;overflow:hidden"
>
  <div
    style="text-align:center;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:15px;color:#f0f3f8;padding-bottom:4px"
  >
    r<span style="color:#00e0ff">c</span>
  </div>

  <nav style="display:flex;flex-direction:column;gap:3px;margin-top:26px">
    {
      nav.map((n) => (
        <a href={n.href} title={n.label} class:list={['adm-nav', 'adm-nav-c', { active: n.key === page }]}>
          <span style="display:flex;flex-shrink:0" set:html={svg(n.key)} />
        </a>
      ))
    }
  </nav>

  <div style="margin-top:auto;display:flex;flex-direction:column;gap:10px">
    <div title="all systems online" style="display:flex;justify-content:center;padding:6px 0">
      <span
        style="width:9px;height:9px;border-radius:50%;background:#3fb950;box-shadow:0 0 8px #3fb950;animation:admPulseDot 2s ease-in-out infinite"
      ></span>
    </div>
    <button data-side-toggle class="adm-toggle" title="Expand sidebar" aria-label="Expand sidebar">»</button>
    <a href="/admin/auth/signout" class="adm-signout adm-signout-c" title="Sign out" aria-label="Sign out">⏻</a>
  </div>
</aside>

<style>
  .adm-nav {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 12px;
    border-radius: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    text-decoration: none;
    color: #8b949e;
    border: 1px solid transparent;
    background: transparent;
    transition: all 0.16s;
  }
  .adm-nav:hover {
    border-color: rgba(255, 255, 255, 0.14);
  }
  .adm-nav.active {
    color: #00e0ff;
    background: rgba(0, 224, 255, 0.08);
    border-color: rgba(0, 224, 255, 0.22);
  }
  .adm-nav-c {
    justify-content: center;
    padding: 10px 0;
    gap: 0;
  }
  .adm-toggle {
    width: 100%;
    padding: 8px 0;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: transparent;
    color: #6e7681;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .adm-toggle:hover {
    color: #00e0ff;
    border-color: rgba(0, 224, 255, 0.35);
  }
  .adm-signout {
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #6e7681;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .adm-signout:hover {
    color: #ff2e97;
  }
  .adm-signout-c {
    font-size: 15px;
  }
</style>
