# .env.example — control-center env contract. Copy to `.env` (gitignored) for
# local dev; set the same vars as Vercel project env vars for deploy.
#
# RULES (ADR-007, ADR-011): every var below is SERVER-ONLY. None are PUBLIC_-
# prefixed, so Astro never inlines them into the client bundle. The public plane
# ships zero secrets; only the server-rendered /admin + /api routes read these.

# --- Supabase (control-center datastore — ADR-011) -------------------------
# Project: kissrobert-control-center (org "Pandavo", region eu-central-1)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Service-role key — bypasses RLS. Server-side ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Publishable/anon key — used by the /admin auth flow (ADR-012). Safe to expose,
# but kept server-only (no PUBLIC_ prefix) since the whole flow is SSR.
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Control-center auth allowlist (ADR-012) -------------------------------
# The single GitHub login permitted into /admin. Anyone else is denied.
ADMIN_GITHUB_LOGIN=Nagoyashi

# --- Cron endpoints (Phase 3 uptime + ops snapshots — ADR-013) -------------
# Protects both /api/cron/ping (uptime.yml) and /api/cron/snapshot (snapshot.yml).
# The scheduled GitHub Actions send `Authorization: Bearer <this>`. Set the SAME
# value as a Vercel env var (the endpoints check it) AND as a GitHub repo secret
# (the Actions send it). Any long random string.
CRON_SECRET=a-long-random-string

# --- GitHub webhook (instant ops snapshots — #62, ADR-013) -----------------
# Verifies POSTs to /api/webhooks/github (HMAC X-Hub-Signature-256). Set the SAME
# value as a Vercel env var AND as each repo's webhook "Secret" in GitHub. Server-
# only. Without it (or on a bad signature) the endpoint returns 401 — fails closed.
GITHUB_WEBHOOK_SECRET=a-long-random-string

# --- AI layer (ADR-015) ----------------------------------------------------
# Anthropic Claude key for the daily fleet-digest (/api/cron/digest). Server-only
# (non-PUBLIC_, never in the client bundle). Model: claude-opus-4-8 by default.
# Without it, /api/cron/digest returns 503 and /admin/digest shows a setup hint.
ANTHROPIC_API_KEY=your-anthropic-key
# Voyage AI key for embedding the pgvector ops-memory (voyage-3.5-lite, 1024-d).
# Server-only. Without it, memories are still stored (embedding null) but not
# semantically searchable. Free tier is generous. https://voyageai.com
VOYAGE_API_KEY=your-voyage-key

# --- GitHub App (build-time fleet data — ADR-007) --------------------------
# Already used by src/lib/github.ts at build time; kept here for completeness.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=
